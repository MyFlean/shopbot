{
  "schema_version": "1.0",
  "config_name": "unified_search_goal_rules",
  "updated_at": "2026-08-05T00:00:00Z",
  "goals": [
    {
      "id": "high_protein",
      "label": "High Protein",
      "enabled": true,
      "include_all": [
        {
          "any_of": [
            { "field": "category_data.nutritional.nutri_breakdown.protein g", "op": "gte", "value": 10 },
            { "field": "derived.protein_cal_pct", "op": "gte", "value": 15 },
            { "field": "category_data.tags.highlight_tags.protein_tags.positive", "op": "contains_any", "value": ["high_protein_density"] }
          ]
        }
      ],
      "exclude_any": [
        { "field": "flean_score.adjusted_score", "op": "lt", "value": 50 },
        {
          "all_of": [
            { "field": "category_data.tags.highlight_tags.sweetners_sugar_tags.negative", "op": "contains_any", "value": ["bad_sweetners_used"] },
            { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "op": "gt", "value": 10 }
          ]
        }
      ],
      "sort_order": [
        { "field": "stats.protein_percentiles.category_percentile", "order": "desc" },
        { "field": "flean_score.adjusted_score", "order": "desc" }
      ]
    },
    {
      "id": "weight_loss_fat_loss",
      "label": "Weight Loss / Fat Loss",
      "enabled": true,
      "include_all": [
        { "field": "category_data.nutritional.nutri_breakdown.energy kcal", "op": "lte", "value": 400 },
        { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "op": "lte", "value": 5 },
        {
          "any_of": [
            { "field": "category_data.nutritional.nutri_breakdown.fiber g", "op": "gte", "value": 3 },
            { "field": "flean_score.bonuses.fiber_bonus", "op": "gt", "value": 0 },
            { "field": "derived.protein_cal_pct", "op": "gte", "value": 12 }
          ]
        }
      ],
      "exclude_any": [
        {
          "all_of": [
            { "field": "category_data.processing_type", "op": "eq", "value": "ultra_processed" },
            { "field": "flean_score.adjusted_score", "op": "lt", "value": 55 }
          ]
        },
        { "field": "category_data.nutritional.nutri_breakdown.total fat g", "op": "gt", "value": 20 }
      ],
      "sort_order": [
        { "field": "flean_score.penalties.calories_penalty", "order": "asc" },
        { "field": "derived.protein_cal_pct", "order": "desc" }
      ]
    },
    {
      "id": "muscle_gain",
      "label": "Muscle Gain",
      "enabled": true,
      "include_all": [
