        { "field": "category_data.tags.highlight_tags.ingredients_tags.positive", "op": "contains_any", "value": ["no_harmful_additives"] },
        { "field": "category_data.tags.highlight_tags.ingredients_tags.positive", "op": "contains_any", "value": ["preservative_free"] }
      ],
      "exclude_any": [
        { "field": "derived.additives_count", "op": "gt", "value": 2 },
        {
          "field": "ingredients.normalised.sweetners",
          "op": "contains_any",
          "value": ["sucralose", "aspartame", "acesulfame"]
        }
      ],
      "sort_order": [
        { "field": "flean_score.bonuses.simplicity_bonus", "order": "desc" },
        { "field": "flean_score.bonuses.wholefood_bonus", "order": "desc" },
        { "field": "flean_score.adjusted_score", "order": "desc" }
      ]
    },
    {
      "id": "low_sugar_sugar_control",
      "label": "Low Sugar / Sugar Control",
      "enabled": true,
      "include_all": [
        { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "op": "lte", "value": 2 },
        { "field": "category_data.nutritional.nutri_breakdown.total sugar g", "op": "lte", "value": 8 }
      ],
      "exclude_any": [
        {
          "field": "ingredients.normalised.sweetners",
          "op": "contains_any",
          "value": ["sugar", "invert sugar syrup", "glucose syrup", "maltodextrin", "honey"]
