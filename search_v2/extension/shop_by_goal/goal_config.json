        { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "op": "gt", "value": 2 },
        { "field": "category_data.tags.highlight_tags.sweetners_sugar_tags.negative", "op": "not_empty", "value": true }
      ],
      "sort_order": [
        { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "order": "asc" },
        { "field": "stats.sugar_penalty_percentiles.global_percentile", "order": "asc" }
      ]
    },
    {
      "id": "kids_friendly",
      "label": "Kids Friendly",
      "enabled": true,
      "include_all": [
        { "field": "category_data.tags.highlight_tags.ingredients_tags.positive", "op": "contains_any", "value": ["no_harmful_additives"] },
        { "field": "category_data.nutritional.nutri_breakdown.added sugar g", "op": "lte", "value": 8 },
        { "field": "category_data.nutritional.nutri_breakdown.trans fat g", "op": "eq", "value": 0 },
        { "field": "flean_score.adjusted_score", "op": "gte", "value": 60 }
