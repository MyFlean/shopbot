        { "field": "category_data.nutritional.nutri_breakdown.energy kcal", "op": "gte", "value": 350 },
        {
          "any_of": [
            { "field": "category_data.tags.highlight_tags.protein_tags.positive", "op": "contains_any", "value": ["complete_amino_profile"] },
