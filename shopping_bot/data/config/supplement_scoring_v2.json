  "clinical_dose_ref": {
    "Creatine monohydrate": {
      "threshold": "3-5 g/day maintenance",
      "notes": "ISSN position stand. 3 g is the floor; 5 g standard. >10 g/serving is not better - do not award above 100."
    },
    "Beta-alanine": {
      "threshold": "3.2 g/day",
      "notes": "Chronic loading ingredient; per-serving dose matters only if it is a once-daily product."
    },
    "L-Citrulline (pure)": {
      "threshold": "6-8 g",
      "notes": "Acute, 30-60 min pre-training. If declared as Citrulline Malate 2:1, multiply by 0.5."
    },
    "Caffeine anhydrous": {
      "threshold": "3-6 mg/kg bodyweight; 150-250 mg absolute",
      "notes": "Absolute band used since bodyweight is unknown at catalogue level."
    },
    "Leucine (single serving)": {
      "threshold": "2.5 g young adults; 3.0 g over-40s",
      "notes": "The leucine threshold for maximal MPS. Score against 2.5 g by default."
    },
    "Total EAA (single serving)": {
      "threshold": "6-10 g",
      "notes": "6 g EAA produces roughly twice the anabolic response of 3 g."
    },
    "Betaine anhydrous": {
      "threshold": "2.5 g",
      "notes": ""
    },
    "Taurine": {
      "threshold": "1-2 g",
      "notes": ""
    },
    "L-Theanine": {
      "threshold": "100-200 mg, paired 1:1 to 1:2 with caffeine",
      "notes": "Only credited when caffeine is present."
    },
    "Beetroot nitrate": {
      "threshold": "400-600 mg nitrate",
      "notes": "Score the NITRATE content, not the beetroot extract weight."
    },
    "Glycerol (65-80% powder)": {
      "threshold": "2-4 g yield",
      "notes": ""
    },
    "Ashwagandha (KSM-66/Sensoril)": {
      "threshold": "300-600 mg standardised",
      "notes": "Must state the standardisation to be credited."
    },
    "Vitamin D3": {
      "threshold": "600-2000 IU",
      "notes": "Above 4000 IU per serving: flag, do not reward."
    },
    "EPA+DHA combined": {
      "threshold": "500-1000 mg",
      "notes": "Score EPA+DHA, NOT total fish oil weight. A 1000 mg softgel is commonly only 300 mg EPA+DHA."
    }
  },
